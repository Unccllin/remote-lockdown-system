# --- Core ---
NODE_ENV=production
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Set to 1 to allow running with dev/test defaults in non-production NODE_ENV.
# In production (NODE_ENV=production), this is ignored and strict validation applies.
# ALLOW_NON_PROD=1

# --- Database ---
# Either set DATABASE_URL (cloud) OR the individual DB_* vars (local).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lockdown_db
DB_USER=postgres
DB_PASSWORD=yourpassword
# FA6: SSL certificate verification. Default: true (secure).
# Set to false ONLY for self-signed CAs in dev/test. Warns in production.
DB_SSL_VERIFY=true
# For individual vars mode, enable SSL with DB_SSL=true
# DB_SSL=true

# --- Auth secrets (FA6) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
# FA3: AGENT_SHARED_KEY is transitional — used for legacy device auth fallback.
# New devices use per-device API keys. This key only works for devices
# that don't have an api_key_hash set yet.
# In production, use AGENT_SHARED_KEY_FILE to read from a secrets file.
AGENT_SHARED_KEY=change_this_to_a_long_random_key
# AGENT_SHARED_KEY_FILE=/run/secrets/agent_shared_key
# FA3: Pepper for per-device API key hashing (separate from AGENT_SHARED_KEY).
# Falls back to AGENT_SHARED_KEY if not set. Use _FILE convention for KMS bridge.
AGENT_KEY_PEPPER=change_this_to_a_long_random_pepper
# AGENT_KEY_PEPPER_FILE=/run/secrets/agent_key_pepper

# --- Field encryption at rest (FA2) ---
# 32-byte hex key (64 hex chars). Generate with: openssl rand -hex 32
# In production, use FIELD_ENCRYPTION_KEY_FILE to read from a secrets file
# (Docker secrets, Kubernetes secrets, KMS bridge) instead of putting the
# key in this env file.
FIELD_ENCRYPTION_KEY=change_this_to_a_32_byte_hex_key_64_chars_total_aaaaaaaa
# FIELD_ENCRYPTION_KEY_FILE=/run/secrets/field_encryption_key

# --- Location data encryption (FA5) ---
# 32-byte hex key (64 hex chars). Generate with: openssl rand -hex 32
# Separate from FIELD_ENCRYPTION_KEY — different blast radius.
LOCATION_FIELD_KEY=change_this_to_a_32_byte_hex_key_64_chars_total_bbbbbbbb
# LOCATION_FIELD_KEY_FILE=/run/secrets/location_field_key
# FA5: Retention period for location data (days). Default 90, hard ceiling 180.
LOCATION_RETENTION_DAYS=90

# --- Agent update signing (S0.6 / B-006) ---
# Ed25519 private key used to sign /api/agent/update metadata
# ("v1:{version}:{sha256}"). Agents verify against a pinned update-domain
# public key — a channel-delivered SHA-256 alone is self-certifying.
# Value may be a filesystem path to a PEM file or the inline PEM itself.
# Generate with: openssl genpkey -algorithm ed25519 -out update_signing.key
#                openssl pkey -in update_signing.key -pubout -out update_signing.pub
# Deploy update_signing.pub to agents via update_public_key (agent config).
# MUST be a different key from the recovery-escrow keypair (key domains).
# If unset, updates are served UNSIGNED — agents with update_public_key
# configured will refuse them. Configure this in production.
# UPDATE_SIGNING_KEY=/run/secrets/update_signing_key

# --- Registration (FA3) ---
# Set to true only during initial setup to create the first admin.
# After that, keep false. Bootstrap exception: if admins table is empty,
# first registration is allowed regardless of this flag.
REGISTRATION_ENABLED=false

# --- HMAC Agent Authentication (optional) ---
# Require HMAC signatures on agent requests (default: false, transition mode).
# Set to true to reject unsigned agent requests.
# REQUIRE_HMAC=false
# Use DB-backed nonce cache for multi-instance deployments (default: false, in-memory).
# USE_DB_NONCE_CACHE=false

# --- HMAC security tunables (optional) ---
# Timestamp window for HMAC signature validation (seconds). Default: 300 (5 min).
# HMAC_TIMESTAMP_WINDOW_SECONDS=300
# Nonce time-to-live for replay protection (milliseconds). Default: 600000 (10 min).
# HMAC_NONCE_TTL_MS=600000
# Interval for cleaning up expired nonces from the in-memory cache (milliseconds). Default: 300000 (5 min).
# HMAC_CLEANUP_INTERVAL_MS=300000

# --- Agent adaptive polling (optional, seconds) ---
# Poll intervals sent to the agent based on device status. Defaults shown.
# ADAPTIVE_POLL_STOLEN_SEC=30
# ADAPTIVE_POLL_TRACKING_SEC=30
# ADAPTIVE_POLL_RECOVERING_SEC=30
# ADAPTIVE_POLL_LOCKED_SEC=60
# ADAPTIVE_POLL_ACTIVE_SEC=300

# --- Alert scheduler (optional) ---
# Interval for the alert scheduler loop (milliseconds). Default: 60000 (60s).
# ALERT_SCHEDULER_INTERVAL_MS=60000
# Default poll interval baseline used for staleness (seconds). Default: 300 (5 min).
# ALERT_POLL_INTERVAL_SEC=300
# A device is stale when last_checkin is older than this threshold (seconds). Default: 600 (10 min).
# STALE_DEVICE_THRESHOLD_SEC=600

# --- Retention scheduler (optional) ---
# Interval for the location data retention purge loop (milliseconds). Default: 86400000 (24h).
# RETENTION_SCHEDULER_INTERVAL_MS=86400000

# --- Notifications (optional) ---
# Email notifications via SMTP (all 6 vars must be set to enable email).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# EMAIL_FROM=alerts@yourdomain.com
# EMAIL_TO=admin@yourdomain.com
# Generic webhook URL for notifications (POST JSON payload).
# NOTIFICATION_WEBHOOK_URL=
# Slack incoming webhook URL for notifications.
# SLACK_WEBHOOK_URL=

# --- Google Geolocation API (optional) ---
# Enables WiFi triangulation in agents (~20-50m accuracy vs IP ~10-50km).
# Set on the server — automatically included in generated agent installers.
# GOOGLE_API_KEY=AIza_your_key_here
