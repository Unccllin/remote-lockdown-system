# .env.prod.example — Copy to .env.prod and fill in your values
#
# Generate strong secrets with: openssl rand -hex 32

# --- Domain ---
DOMAIN=lockdown.example.com

# --- PostgreSQL ---
POSTGRES_DB=lockdown
POSTGRES_USER=lockdown
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- Security Keys (generate with: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
AGENT_SHARED_KEY=CHANGE_ME_48_ALPHANUM_CHARS
AGENT_KEY_PEPPER=CHANGE_ME_64_HEX_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
LOCATION_FIELD_KEY=CHANGE_ME_64_HEX_CHARS

# --- CORS ---
# The domain where the dashboard will be served
CORS_ORIGIN=https://lockdown.example.com

# --- Optional Settings ---
# Location data retention (days, default: 90)
LOCATION_RETENTION_DAYS=90

# Phase 5: Command expiry (days, default: 30)
COMMAND_EXPIRY_DAYS=30

# --- Notifications (Phase 13) ---
# All channels are optional. If none are configured, notifications are
# logged to the server console but not sent externally. At least one
# channel is recommended for production so you get alerted when:
#   - A device is flagged as stolen
#   - A lockdown is confirmed by the agent
#   - A device goes stale (no checkin for 24h)
#   - A deadman switch triggers
#   - DB degradation is detected

# Generic webhook (JSON POST with { eventType, timestamp, payload })
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/lockdown-alerts

# Slack incoming webhook (replace with your actual webhook URL from Slack admin)
# Format: https://hooks.slack.com/services/<workspace>/<channel>/<token>
# SLACK_WEBHOOK_URL=

# Email via SMTP (all 6 vars required for email to work)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# EMAIL_FROM=lockdown-alerts@example.com
# EMAIL_TO=security-team@example.com

# --- Automated Backups ---
# Encryption key for backup files (openssl symmetric, AES-256-CBC).
# Generate with: openssl rand -hex 32
# REQUIRED if the backup service is enabled (it is by default).
BACKUP_ENCRYPT_KEY=CHANGE_ME_64_HEX_CHARS

# Backup schedule (cron format, default: 2 AM daily)
# Examples: "0 2 * * *" = daily at 2am, "0 */6 * * *" = every 6 hours,
#           "0 2 * * 0" = weekly on Sunday at 2am
# BACKUP_SCHEDULE=0 2 * * *

# Delete backups older than N days (default: 30)
# BACKUP_RETENTION_DAYS=30

# --- Monitoring (optional, enable with --profile monitoring) ---
# Grafana admin credentials (change from defaults immediately on first login)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin

# --- Grafana Cloud Free (optional, enable with --profile logging) ---
# Ships logs to Grafana Cloud Loki (free tier: 50GB/month, 14-day retention).
# Set up with: scripts/setup-free-tiers.sh
# Get these values from Grafana Cloud → Connections → Loki:
#   LOKI_URL      = https://logs-prod-xxx.grafana.net/loki/api/v1/push
#   LOKI_USERNAME = your Grafana Cloud instance ID (a number, e.g. 12345)
#   LOKI_API_KEY  = an API key created in Grafana Cloud → API Keys
# LOKI_URL=
# LOKI_USERNAME=
# LOKI_API_KEY=

# --- AWS Parameter Store (optional, free tier: 10,000 parameters) ---
# When enabled, the server fetches secrets from AWS Parameter Store at startup
# instead of reading them from this .env file. Set up with:
#   scripts/setup-free-tiers.sh
#
# Parameters must be named /lockdown/prod/<SECRET_NAME> (e.g., /lockdown/prod/JWT_SECRET)
# and created as SecureString type. The AWS_SSM_PREFIX controls the path prefix.
#
# AWS_SSM_ENABLED=false
# AWS_SSM_PREFIX=/lockdown/prod/
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Cross-Platform Agent Binary Download (Solution A) ---
# When the admin requests an installer for a platform different from the
# server's platform, the server downloads the agent binary from GitHub Releases.
# These settings configure the download source. All optional with defaults.

# GitHub repo owner (default: unccllin)
# AGENT_BINARY_RELEASE_OWNER=unccllin

# GitHub repo name (default: remote-lockdown-system)
# AGENT_BINARY_RELEASE_REPO=remote-lockdown-system

# Release tag to download from (default: latest)
# AGENT_BINARY_RELEASE_TAG=latest

# GitHub token for private repos or higher rate limits (optional)
# GITHUB_TOKEN=ghp_your_token_here
