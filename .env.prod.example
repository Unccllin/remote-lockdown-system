# .env.prod.example — Copy to .env.prod and fill in your values
#
# Generate strong secrets with: openssl rand -hex 32

# --- Domain ---
DOMAIN=lockdown.example.com

# --- PostgreSQL ---
POSTGRES_DB=lockdown
POSTGRES_USER=lockdown
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- Security Keys (generate with: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
AGENT_SHARED_KEY=CHANGE_ME_48_ALPHANUM_CHARS
AGENT_KEY_PEPPER=CHANGE_ME_64_HEX_CHARS
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
LOCATION_FIELD_KEY=CHANGE_ME_64_HEX_CHARS

# --- CORS ---
# The domain where the dashboard will be served
CORS_ORIGIN=https://lockdown.example.com

# --- Optional Settings ---
# Location data retention (days, default: 90)
LOCATION_RETENTION_DAYS=90

# Phase 5: Command expiry (days, default: 30)
COMMAND_EXPIRY_DAYS=30

# --- Cross-Platform Agent Binary Download (Solution A) ---
# When the admin requests an installer for a platform different from the
# server's platform, the server downloads the agent binary from GitHub Releases.
# These settings configure the download source. All optional with defaults.

# GitHub repo owner (default: unccllin)
# AGENT_BINARY_RELEASE_OWNER=unccllin

# GitHub repo name (default: remote-lockdown-system)
# AGENT_BINARY_RELEASE_REPO=remote-lockdown-system

# Release tag to download from (default: latest)
# AGENT_BINARY_RELEASE_TAG=latest

# GitHub token for private repos or higher rate limits (optional)
# GITHUB_TOKEN=ghp_your_token_here
