[agent]
# Primary server — Cloudflare Worker (always-on, free tier, global edge).
# Deploy with: cd serverless && wrangler deploy
# Enroll devices via: curl -X POST <server_url>/api/enroll
server_url = https://lockdown-serverless.mainacollins196.workers.dev
# Optional fallback — if the Worker is unreachable, try this endpoint
# (e.g. a self-hosted Express server). Leave empty for no fallback.
serverless_url =
agent_key = change_this_to_match_server_AGENT_SHARED_KEY
hostname = DEVICE-HOSTNAME-001
poll_interval = 30
lockdown_folder = C:\Users\FieldAgent\SecureData
lock_sentinel = C:\ProgramData\LockdownAgent\.locked
verify_tls = true

# Geolocation settings (for covert tracking mode)
# Google API key for WiFi triangulation (optional — falls back to IP geolocation)
google_api_key =
# How often to report location when in tracking mode (seconds, default 300 = 5min)
location_interval = 300

# Boot lockdown settings (HP machines with WMI BIOS interface)
# When true, the agent locks the UEFI/BIOS and Windows BCD on lockdown
# commands to prevent boot from USB/PXE/Safe Mode/WinRE. Reverted on unlock.
boot_lock_enabled = true
# Pre-existing BIOS Setup password (if the machine already has one set).
# Leave empty if no BIOS password is set — the agent will generate a random
# one during lockdown and report it to the server.
# If a password IS already set and this is empty, UEFI lockdown is skipped.
uefi_password =

# --- Key lifecycle & brick prevention (A1/A4/A8) ---
# Pending ACK state file (transient, deleted on ACK success).
# Written BEFORE encryption so a crash doesn't lose the key.
pending_ack_file = C:\ProgramData\LockdownAgent\.pending_ack

# Recovery key file (long-lived, RSA-wrapped, deleted on unlock).
# Contains the Fernet data key wrapped with IT's master RSA public key.
# Enables offline recovery if the server is destroyed.
recovery_key_file = C:\ProgramData\LockdownAgent\.recovery_key

# IT's offline master recovery PUBLIC key (PEM format).
# The PRIVATE key is kept in a safe/HSM by IT — never on the device.
# Generate with: openssl genrsa -out recovery_master.key 4096
#                openssl rsa -in recovery_master.key -pubout -out recovery_master.pub
# Distribute recovery_master.pub to all devices; keep recovery_master.key offline.
recovery_public_key = C:\ProgramData\LockdownAgent\recovery_master.pub

# Update-signing PUBLIC key (PEM format, Ed25519) — S0.6 / B-006.
# The agent verifies a detached Ed25519 signature over the update metadata
# ("v1:{version}:{sha256}") served by /api/agent/update. This pins update
# authenticity to a key the server never sees — a compromised server that
# swaps both binary and hash still cannot forge the signature.
# MUST be a DIFFERENT key from recovery_public_key (separate key domains:
# update signing vs. recovery escrow).
# Generate with: openssl genpkey -algorithm ed25519 -out update_signing.key
#                openssl pkey -in update_signing.key -pubout -out update_signing.pub
# Deploy update_signing.pub to devices; set UPDATE_SIGNING_KEY on the server
# to the private key (file path or inline PEM). Keep the private key offline.
# If unset, updates fall back to channel SHA-256 only (UNAUTHENTICATED —
# a compromised server can push any binary). Configure this in production.
update_public_key = C:\ProgramData\LockdownAgent\update_signing.pub

# A4: Set to true once the server supports command_id dedup on encryption_keys.
# When false, the pending ACK file is written (fixes A1 crash recovery) but
# failed ACKs are not retried (the server may not have dedup yet).
# When true, failed ACKs are retried on every loop iteration.
server_supports_ack_dedup = false
