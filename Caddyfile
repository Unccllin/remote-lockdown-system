# Caddyfile — Reverse proxy for the admin server
#
# Caddy automatically provisions and renews TLS certificates via Let's Encrypt.
# Just set your domain in the .env.prod file and Caddy handles the rest.
#
# Usage:
#   1. Set DOMAIN in .env.prod (e.g., lockdown.example.com)
#   2. Point your DNS A record to the server's IP
#   3. docker compose -f docker-compose.prod.yml up -d

{$DOMAIN} {
	# TLS floor (C3 §4 / D-116). The *device* cannot raise its own floor: PBL holds
	# only EFI_HTTP_PROTOCOL, whose HttpDxe sets ConnectionEnd/VerifyMethod/
	# VerifyHost/SessionState and exposes no version, and EDK2's TlsDxe defaults its
	# minimum to TLS 1.0 (NetworkPkg/TlsDxe/TlsDriver.c:263 -> TlsCtxNew(TLS10...)).
	# So the floor is enforced here, where we terminate TLS, and a downgrade cannot
	# succeed even though the client offers it. Caddy's default already excludes
	# TLS < 1.2; stating it makes it auditable and gives scripts/test_tls_floor.py
	# something to verify against a live proxy.
	tls {
		protocols tls1.2 tls1.3
	}

	# Reverse proxy to the admin server
	reverse_proxy server:3001

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	# Compression
	encode gzip zstd

	# Access logs
	log {
		output stdout
		format json
	}

	# Rate limiting (basic — Caddy doesn't have built-in rate limiting,
	# the Express server handles API rate limiting)
}
