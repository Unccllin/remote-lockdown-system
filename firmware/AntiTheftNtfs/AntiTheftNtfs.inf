## @file
#  AntiTheftNtfs.inf — UEFI application that loads NTFS driver and reads a file
#
## 

[Defines]
  INF_VERSION                = 0x00010005
  BASE_NAME                  = AntiTheftNtfs
  FILE_GUID                  = B3C4D5E6-F7A8-9012-BCDE-F12345678901
  MODULE_TYPE                = UEFI_APPLICATION
  VERSION_STRING             = 1.0
  ENTRY_POINT                = AntiTheftNtfsEntryPoint

[Sources]
  AntiTheftNtfs.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  DevicePathLib
  MemoryAllocationLib

[Protocols]
  gEfiSimpleFileSystemProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiLoadedImageProtocolGuid
  gEfiDevicePathProtocolGuid

[Guids]
  gEfiFileInfoGuid
