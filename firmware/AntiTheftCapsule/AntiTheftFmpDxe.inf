## @file
#  AntiTheftFmpDxe.inf — Anti-theft DXE driver delivered via capsule
#
#  This driver is the payload of a UEFI capsule update. When the capsule
#  is processed, this driver is flashed into the firmware volume and
#  executes on every boot before the OS loads.
#
##

[Defines]
  INF_VERSION                = 0x00010005
  BASE_NAME                  = AntiTheftFmpDxe
  FILE_GUID                  = D5E6F7A8-B9C0-1234-DEF0-567890ABCDEF
  MODULE_TYPE                = DXE_DRIVER
  VERSION_STRING             = 1.0
  ENTRY_POINT                = AntiTheftFmpDxeEntryPoint

[Sources]
  AntiTheftFmpDxe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib

[Depex]
  TRUE
