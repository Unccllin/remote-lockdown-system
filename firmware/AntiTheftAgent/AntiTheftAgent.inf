## @file
#  AntiTheftAgent.inf — Integrated Anti-Theft Firmware Agent
#
#  DXE driver that runs on every boot before the OS. Combines:
#  - NVRAM variable management
#  - Network HTTP check-in
#  - NTFS marker file reading
#  - TPM availability check
#  - Lockdown enforcement
#
#  Delivered via UEFI capsule update. Persists in SPI flash.
#
##

[Defines]
  INF_VERSION                = 0x00010005
  BASE_NAME                  = AntiTheftAgent
  FILE_GUID                  = D5E6F7A8-B9C0-1234-DEF0-567890ABCDEF
  MODULE_TYPE                = DXE_DRIVER
  VERSION_STRING             = 1.0
  ENTRY_POINT                = AntiTheftAgentEntryPoint

[Sources]
  AntiTheftAgent.c
  nvram.c
  network.c
  ntfs.c
  lockdown.c
  tpm.c
  dns_tunnel.c

[Packages]
  MdePkg/MdePkg.dec
  NetworkPkg/NetworkPkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SecurityPkg/SecurityPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  BaseLib
  BaseMemoryLib
  DebugLib
  PcdLib
  MemoryAllocationLib
  PrintLib
  DevicePathLib
  RegisterFilterLib
  StackCheckLib
  StackCheckFailureHookLib

[Protocols]
  gEfiHttpServiceBindingProtocolGuid
  gEfiHttpProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiTcg2ProtocolGuid
  gEfiDns4ServiceBindingProtocolGuid
  gEfiDns4ProtocolGuid

[Guids]
  gEfiFileInfoGuid

[Depex]
  TRUE
