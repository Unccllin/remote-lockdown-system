tmp/

# pi agent task logs (per-session, local only)
.pi/

# A literal Windows path can be created on POSIX by naive defaults (S141 root
# cause fixed in agent.py._programdata_dir; this is belt-and-braces).
C:\\ProgramData/

# Generated C compile database (machine-local EDK II paths)
firmware/PblPkg/compile_commands.json

# Generated documentation site (scripts/build_docs_site.py)
site/

# Semgrep report (make sast / CI)
semgrep.json

# Update-signing key material (S242): the private key signs releases and must
# never be committed; the public key is generated per deployment and shipped to
# devices, not stored in the repository.
update_signing.key
update_signing.pub
*.key
!**/fixtures/*.key

# Generated by firmware/PblPkg/host-tests/run-host-tests.sh. The single sources of
# truth are PblApp/PblApp.h, PblPkg.dec and the vendored EDK II headers under
# include/IndustryStandard/ (which ARE committed, so the drift check can compare them) —
# none of the generated views below is ever committed.
firmware/PblPkg/host-tests/include/*.generated.h
firmware/PblPkg/host-tests/build/
