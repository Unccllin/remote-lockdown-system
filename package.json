{
  "name": "remote-lockdown-system",
  "version": "1.0.0",
  "description": "Remote Device Lockdown System — unified test runner",
  "private": true,
  "scripts": {
    "test": "npm run test:server && npm run test:agent",
    "test:server": "cd server && node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "test:agent": "bash scripts/run-agent-tests.sh -v",
    "test:dashboard": "cd dashboard && npx vitest run",
    "test:worker": "cd serverless && npx vitest run",
    "test:electron": "cd electron && node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:ci": "npm run test:server -- --maxWorkers=1 && npm run test:agent",
    "test:coverage": "npm run test:server:coverage && npm run test:agent:coverage && npm run test:dashboard:coverage && npm run test:worker:coverage && npm run test:electron:coverage",
    "test:server:coverage": "cd server && node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles --coverage",
    "test:agent:coverage": "bash scripts/run-agent-tests.sh --cov=. --cov-report=term --cov-report=lcov --cov-report=json",
    "test:dashboard:coverage": "cd dashboard && npx vitest run --coverage",
    "test:worker:coverage": "cd serverless && npx vitest run --coverage",
    "test:electron:coverage": "cd electron && node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --coverage",
    "dev:server": "cd server && node dev-start-sqlite.js",
    "dev:dashboard": "cd dashboard && npx vite",
    "dev:electron": "cd electron && npm run start:dev",
    "build:dashboard": "cd dashboard && npx vite build",
    "build:electron": "cd electron && npm run build"
  }
}
