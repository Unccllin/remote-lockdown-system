<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime entitlements for the Electron admin app -->
    <!-- These are the minimum entitlements needed for Electron to function -->

    <!-- Allow JIT (V8 JavaScript engine needs this) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (V8 needs this) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading of unsigned dylibs (native modules) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access (server + agent communication) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File system access (SQLite database, config, agent binaries) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
