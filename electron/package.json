{
  "name": "remote-lockdown-admin",
  "version": "1.0.0",
  "description": "Remote Device Lockdown System — Admin Desktop App",
  "author": {
    "name": "Remote Lockdown",
    "email": "research@remotelockdown.com",
    "url": "https://github.com/unccllin/remote-lockdown-system"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "ELECTRON_IS_DEV=1 electron .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "build:agent": "cd ../agent && python3 -m PyInstaller agent.spec --noconfirm && python3 -m PyInstaller watchdog.spec --noconfirm && python3 -m PyInstaller offline_recovery.spec --noconfirm",
    "build:dashboard": "cd ../dashboard && npx vite build",
    "build": "npm run build:dashboard && npm run build:agent && electron-builder",
    "build:win": "npm run build:dashboard && npm run build:agent && electron-builder --win",
    "build:mac": "npm run build:dashboard && npm run build:agent && electron-builder --mac",
    "build:linux": "npm run build:dashboard && npm run build:agent && electron-builder --linux",
    "publish": "npm run build:dashboard && npm run build:agent && electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@noble/hashes": "^1.4.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tar": "^7.5.21",
    "@noble/hashes": "^1.4.0"
  },
  "build": {
    "appId": "com.remotelockdown.admin",
    "productName": "Remote Lockdown Admin",
    "copyright": "Copyright © 2026 Remote Lockdown",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "setup-wizard.js",
      "setup.html",
      "server-starter.js",
      "config.js",
      "updater.js",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/express/**/*",
      "node_modules/body-parser/**/*",
      "node_modules/accepts/**/*",
      "node_modules/content-disposition/**/*",
      "node_modules/content-type/**/*",
      "node_modules/cookie/**/*",
      "node_modules/cookie-signature/**/*",
      "node_modules/debug/**/*",
      "node_modules/depd/**/*",
      "node_modules/encodeurl/**/*",
      "node_modules/escape-html/**/*",
      "node_modules/etag/**/*",
      "node_modules/finalhandler/**/*",
      "node_modules/fresh/**/*",
      "node_modules/http-errors/**/*",
      "node_modules/merge-descriptors/**/*",
      "node_modules/methods/**/*",
      "node_modules/mime-db/**/*",
      "node_modules/mime-types/**/*",
      "node_modules/on-finished/**/*",
      "node_modules/parseurl/**/*",
      "node_modules/path-to-regexp/**/*",
      "node_modules/proxy-addr/**/*",
      "node_modules/qs/**/*",
      "node_modules/range-parser/**/*",
      "node_modules/raw-body/**/*",
      "node_modules/safe-buffer/**/*",
      "node_modules/safer-buffer/**/*",
      "node_modules/send/**/*",
      "node_modules/serve-static/**/*",
      "node_modules/setprototypeof/**/*",
      "node_modules/statuses/**/*",
      "node_modules/toidentifier/**/*",
      "node_modules/type-is/**/*",
      "node_modules/unpipe/**/*",
      "node_modules/utils-merge/**/*",
      "node_modules/vary/**/*",
      "node_modules/bytes/**/*",
      "node_modules/call-bind/**/*",
      "node_modules/get-intrinsic/**/*",
      "node_modules/hasown/**/*",
      "node_modules/has-symbols/**/*",
      "node_modules/function-bind/**/*",
      "node_modules/has-proto/**/*",
      "node_modules/es-define-property/**/*",
      "node_modules/es-errors/**/*",
      "node_modules/gopd/**/*",
      "node_modules/define-data-property/**/*",
      "node_modules/set-function-length/**/*",
      "node_modules/has-property-descriptors/**/*"
    ],
    "extraResources": [
      {
        "from": "../dashboard/dist",
        "to": "dashboard/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../agent/dist",
        "to": "agent",
        "filter": [
          "lockdown-agent",
          "lockdown-agent.exe",
          "lockdown-watchdog",
          "lockdown-watchdog.exe",
          "lockdown-recovery",
          "lockdown-recovery.exe"
        ]
      },
      {
        "from": "../agent/bin",
        "to": "agent/bin",
        "filter": [
          "nssm.exe",
          "nssm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Remote Lockdown"
      },
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.security",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Security",
      "maintainer": "Remote Lockdown <research@remotelockdown.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remote Lockdown Admin",
      "uninstallDisplayName": "Remote Lockdown Admin",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Remote Lockdown Admin"
    },
    "publish": {
      "provider": "github",
      "owner": "unccllin",
      "repo": "remote-lockdown-system"
    },
    "generateUpdatesFilesForAllChannels": true
  }
}
