{
  "name": "remote-lockdown-admin",
  "version": "1.0.0",
  "description": "Remote Device Lockdown System — Admin Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "ELECTRON_IS_DEV=1 electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.remotelockdown.admin",
    "productName": "Remote Lockdown Admin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-starter.js",
      "../server/src/**/*",
      "../server/package.json",
      "../server/node_modules/**/*",
      "../dashboard/dist/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
