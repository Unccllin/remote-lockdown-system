{
  "name": "remote-lockdown-admin",
  "version": "1.0.0",
  "description": "Remote Device Lockdown System — Admin Desktop App",
  "author": {
    "name": "Remote Lockdown",
    "email": "research@remotelockdown.com",
    "url": "https://github.com/unccllin/remote-lockdown-system"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "ELECTRON_IS_DEV=1 electron .",
    "install:server": "cd ../server && npm ci --omit=dev",
    "rebuild:native": "electron-rebuild -f -w sqlite3 -m ../server/node_modules",
    "build:agent": "cd ../agent && python3 -m PyInstaller agent.spec --noconfirm && python3 -m PyInstaller watchdog.spec --noconfirm && python3 -m PyInstaller offline_recovery.spec --noconfirm",
    "build:dashboard": "cd ../dashboard && npx vite build",
    "build": "npm run install:server && npm run rebuild:native && npm run build:dashboard && npm run build:agent && electron-builder",
    "build:win": "npm run install:server && npm run rebuild:native && npm run build:dashboard && npm run build:agent && electron-builder --win",
    "build:mac": "npm run install:server && npm run rebuild:native && npm run build:dashboard && npm run build:agent && electron-builder --mac",
    "build:linux": "npm run install:server && npm run rebuild:native && npm run build:dashboard && npm run build:agent && electron-builder --linux",
    "publish": "npm run install:server && npm run rebuild:native && npm run build:dashboard && npm run build:agent && electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "3.6.1",
    "electron": "^33.0.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.remotelockdown.admin",
    "productName": "Remote Lockdown Admin",
    "copyright": "Copyright © 2026 Remote Lockdown",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-starter.js",
      "config.js",
      "updater.js",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*"
    ],
    "extraResources": [
      {
        "from": "../server/src",
        "to": "server/src",
        "filter": ["**/*"]
      },
      {
        "from": "../server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../dashboard/dist",
        "to": "dashboard/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../agent/dist",
        "to": "agent",
        "filter": [
          "lockdown-agent",
          "lockdown-agent.exe",
          "lockdown-watchdog",
          "lockdown-watchdog.exe",
          "lockdown-recovery",
          "lockdown-recovery.exe"
        ]
      },
      {
        "from": "../agent/bin",
        "to": "agent/bin",
        "filter": [
          "nssm.exe",
          "nssm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Remote Lockdown",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.security",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "Security",
      "maintainer": "Remote Lockdown <research@remotelockdown.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Remote Lockdown Admin",
      "uninstallDisplayName": "Remote Lockdown Admin",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Remote Lockdown Admin"
    },
    "publish": {
      "provider": "github",
      "owner": "unccllin",
      "repo": "remote-lockdown-system"
    },
    "generateUpdatesFilesForAllChannels": true
  }
}
